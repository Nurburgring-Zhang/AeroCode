<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET 9 SDK 默认把引用方的 RuntimeIdentifier 传染给可执行被引用工程
         （IsRidAgnostic=false），导致 Android 头项目构建时本工程被迫按
         net9.0/android-* 还原运行时包而 NETSDK1047。显式声明 RID 无关：
         P2P 构建时保持 portable net9.0；直接构建 / dotnet publish -r win-x64 不受影响。 -->
    <IsRidAgnostic>true</IsRidAgnostic>
    <!-- NETSDK1150 豁免：自包含 publish（指定 RID win-x64 与 self contained）时，
         IsRidAgnostic 的 AeroCode.Mcp 按非自包含 portable 编译，
         SDK 校验「自包含 exe 不得引用非自包含 exe」。本工程只把 Mcp 当库消费，
         其可执行产物另行单独 publish（自包含 win-x64）后合并进发布目录——
         已实测证伪 app-local hostfxr 复用同目录运行时的路线
         （框架依赖 apphost 报 "You must install or update .NET"，EXIT=150），
         故 Mcp sidecar 必须自身自包含。完整推导见 docs/ANDROID_BUILD.md §六。 -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationTitle>AeroCode</ApplicationTitle>
    <ApplicationId>com.AeroCode.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <!-- 注：OTel 埋点在 AeroCode.AI（Http + Runtime instrumentation，Android 兼容）。
         不引 OpenTelemetry.Instrumentation.AspNetCore：本客户端从不托管 ASP.NET，
         且其 Microsoft.AspNetCore.App FrameworkReference 无 android 运行时包（NETSDK1082）。 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroCode.Core\AeroCode.Core.csproj" />
    <ProjectReference Include="..\AeroCode.Skills\AeroCode.Skills.csproj" />
    <ProjectReference Include="..\AeroCode.Harness\AeroCode.Harness.csproj" />
    <ProjectReference Include="..\AeroCode.AI\AeroCode.AI.csproj" />
    <ProjectReference Include="..\AeroAgent.Conversation\AeroAgent.Conversation.csproj" />
    <ProjectReference Include="..\AeroAgent.Moa\AeroAgent.Moa.csproj" />
    <ProjectReference Include="..\AeroAgent.Autonomy\AeroAgent.Autonomy.csproj" />
    <ProjectReference Include="..\AeroCode.Mcp\AeroCode.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AeroCode.Tests" />
  </ItemGroup>

</Project>
