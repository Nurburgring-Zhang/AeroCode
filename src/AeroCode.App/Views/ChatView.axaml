<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             xmlns:views="using:AeroCode.App.Views"
             xmlns:models="using:AeroAgent.Conversation.Models"
             xmlns:conv="using:AeroCode.App.Converters"
             x:Class="AeroCode.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <UserControl.Resources>
        <conv:MarkdownToControlConverter x:Key="MdToControl" />
        <conv:BoolToOpacityConverter x:Key="StreamingOpacity" />
        <conv:GatewayStatusBrushConverter x:Key="GatewayStatus" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 消息悬停操作条：默认隐藏，鼠标悬停气泡时浮现 -->
        <Style Selector="StackPanel.msgActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.msgBubble:pointerover StackPanel.msgActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="260,6,*" Background="{DynamicResource ChatBg}">

        <!-- 左栏：会话列表 + todo 清单 -->
        <Border Grid.Column="0" Background="{DynamicResource ChatPanel}"
                BorderBrush="{DynamicResource ChatBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" Margin="10" HorizontalAlignment="Stretch"
                        Content="＋ 新会话" Command="{Binding NewSessionCommand}" />

                <!-- 待办清单（G5）：当前会话 TodoStore 条目，勾选/删除真实落库 -->
                <Border DockPanel.Dock="Bottom" MaxHeight="230"
                        BorderBrush="{DynamicResource ChatBorder}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="待办清单" Margin="10,8,10,4"
                                   FontWeight="SemiBold" Foreground="{DynamicResource ChatAccent}" FontSize="12" />
                        <ListBox ItemsSource="{Binding Todos}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodoItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  ToolTip.Tip="勾选/取消完成（真实落库）"
                                                  Command="{Binding $parent[ListBox].DataContext.ToggleTodoCommand}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ChatFg}" />
                                        <Button Grid.Column="2" Content="删除" FontSize="10" Padding="3"
                                                VerticalAlignment="Center" ToolTip.Tip="删除待办"
                                                Command="{Binding $parent[ListBox].DataContext.DeleteTodoCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="2">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ChatFg}"
                                               FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding DisplayTime}" Foreground="{DynamicResource ChatMuted}" FontSize="10" />
                                        <TextBlock Text="{Binding Strategy}" Foreground="{DynamicResource ChatCyan}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Content="置顶" FontSize="10" Padding="3"
                                            ToolTip.Tip="置顶/取消置顶"
                                            Command="{Binding $parent[ListBox].DataContext.TogglePinCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="分叉" FontSize="10" Padding="3"
                                            ToolTip.Tip="分叉会话（复制元数据与全部消息为新会话，标题带 fork）"
                                            Command="{Binding $parent[ListBox].DataContext.ForkSessionCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除" FontSize="10" Padding="3"
                                            ToolTip.Tip="删除会话"
                                            Command="{Binding $parent[ListBox].DataContext.DeleteSessionCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右区：消息流 + 输入 -->
        <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource ChatBorder}" ResizeDirection="Columns" />
        <Grid Grid.Column="2" RowDefinitions="*,Auto">

            <!-- 消息流 -->
            <ScrollViewer x:Name="MessageScroller" Grid.Row="0" Padding="16,12"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItemViewModel">
                            <Grid Margin="0,6" ColumnDefinitions="*,Auto,*">
                                <!-- 用户消息靠右 -->
                                <Border Grid.Column="2" IsVisible="{Binding IsUser}" Classes="msgBubble"
                                        Background="{DynamicResource ChatUserBubble}"
                                        CornerRadius="12,12,2,12" Padding="12,8"
                                        MaxWidth="560" HorizontalAlignment="Right">
                                    <StackPanel Spacing="4">
                                        <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ChatFg}" FontSize="14" />
                                        <TextBlock Text="{Binding AttachmentSummary}"
                                                   IsVisible="{Binding !!AttachmentSummary}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ChatMuted}" FontSize="11" />
                                        <!-- 悬停操作条：复制/编辑/重跑/分叉运行 -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Classes="msgActions"
                                                    HorizontalAlignment="Right">
                                            <Button Content="复制" FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="复制这条消息到剪贴板"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CopyMessageCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="编辑" FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="载入输入框编辑，改后可发送重跑或分叉运行"
                                                    Command="{Binding $parent[ItemsControl].DataContext.EditMessageCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="重跑" FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="以这条内容在当前会话重新执行"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RerunMessageCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="分叉运行" FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="分叉为新分支并在新分支重新执行"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ForkAndRunMessageCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 工具结果消息：紧凑行（徽章 + 参数 + 输出） -->
                                <StackPanel Grid.Column="0" IsVisible="{Binding IsTool}"
                                            Margin="{Binding IndentMargin}"
                                            MaxWidth="680" HorizontalAlignment="Left" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{DynamicResource ChatCyan}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding ToolBadge}" FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding StatusGlyph}" IsVisible="{Binding !!StatusGlyph}"
                                                   Foreground="{DynamicResource ChatRed}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource ChatPanel}"
                                            CornerRadius="2,10,10,10" Padding="10,6"
                                            BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding ToolArguments}"
                                                       IsVisible="{Binding !!ToolArguments}"
                                                       Foreground="{DynamicResource ChatMuted}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ToolArguments}" />
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ChatFg}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 助手消息靠左；MOA 归属树按父级深度缩进 -->
                                <StackPanel Grid.Column="0" IsVisible="{Binding IsAssistant}"
                                            Margin="{Binding IndentMargin}"
                                            MaxWidth="680" HorizontalAlignment="Left" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{DynamicResource ChatAccent}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!AttributionBadge}">
                                            <TextBlock Text="{Binding AttributionBadge}" FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                        <Border Background="{DynamicResource ChatCyan}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!Label}">
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                        <Border Background="{DynamicResource ChatBorder}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!ToolCallsBadge}">
                                            <TextBlock Text="{Binding ToolCallsBadge}" FontSize="10"
                                                       Foreground="{DynamicResource ChatFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding StatusGlyph}" IsVisible="{Binding !!StatusGlyph}"
                                                   Foreground="{DynamicResource ChatRed}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UsageBadge}" IsVisible="{Binding !!UsageBadge}"
                                                   Foreground="{DynamicResource ChatMuted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CostBadge}" IsVisible="{Binding !!CostBadge}"
                                                   Foreground="{DynamicResource ChatMuted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource ChatAiBubble}" Classes="msgBubble"
                                            CornerRadius="2,12,12,12" Padding="12,8"
                                            BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding ReasoningContent}" IsVisible="{Binding !!ReasoningContent}"
                                                       Foreground="{DynamicResource ChatMuted}" FontSize="11"
                                                       FontStyle="Italic" TextWrapping="Wrap" />
                                            <ContentControl Content="{Binding Content, Converter={StaticResource MdToControl}}" />
                                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding !!ErrorText}"
                                                       Foreground="{DynamicResource ChatRed}" FontSize="12"
                                                       TextWrapping="Wrap" />
                                            <!-- 悬停操作条：复制助手回复 -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" Classes="msgActions"
                                                        HorizontalAlignment="Left">
                                                <Button Content="复制" FontSize="10" Padding="6,2"
                                                        ToolTip.Tip="复制这条回复到剪贴板"
                                                        Command="{Binding $parent[ItemsControl].DataContext.CopyMessageCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 输入区 -->
            <Border Grid.Row="1" Background="{DynamicResource ChatPanel}"
                    BorderBrush="{DynamicResource ChatBorder}" BorderThickness="0,1,0,0" Padding="12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Provider" Foreground="{DynamicResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding ProviderIds}"
                                      SelectedItem="{Binding SelectedProviderId, Mode=TwoWay}"
                                      MinWidth="140" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="策略" Foreground="{DynamicResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Strategies}"
                                      SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                      ToolTip.Tip="本会话编排策略：Single 单模型 / Router 路由分流 / Decompose 拆解分工 / Ensemble 多模型集成 / Pipeline 起草-评审-修订 / Experts 专家团（经 moa-gateway-pro 网关多专家编排，网关不可达时该轮诚实失败）"
                                      MinWidth="110" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        IsVisible="{Binding IsExpertsSelected}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip.Tip="专家团网关实时状态：绿点=探活在线，琥珀点=不可达/未证实。视图加载与选中专家团时自动真实探活刷新；mock 响应会在消息上标 [Mock]。">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding GatewayReachable, Converter={StaticResource GatewayStatus}}" />
                                <TextBlock Text="{Binding ExpertsGatewayHint}"
                                           Foreground="{DynamicResource ChatMuted}" FontSize="10"
                                           MaxWidth="320" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="档位" Foreground="{DynamicResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PermissionModes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                      MinWidth="104" FontSize="12"
                                      ToolTip.Tip="权限档位：Default 逐工具规则 / AcceptEdits 自动接受编辑 / Plan 只读规划（write_plan 落 PLAN.md）/ Bypass 跳过询问（显式拒绝与危险命令拦截不受影响）" />
                            <TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource ChatMuted}"
                                       FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="4" Content="复制全部对话" FontSize="11" Padding="8,3"
                                VerticalAlignment="Center"
                                ToolTip.Tip="一键复制整段对话（按 用户/助手 轮次）到剪贴板"
                                Command="{Binding CopyConversationCommand}" />
                        <TextBlock Grid.Column="5" Text="{Binding StatusText}"
                                   Foreground="{DynamicResource ChatMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0" />
                    </Grid>
                    <!-- Steer 插话（G5）：流式进行中可见，经 SteerQueue 下一轮注入 -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStreaming}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SteerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="插话（Steer）：流式进行中输入，下一轮注入…"
                                 FontSize="12" MinHeight="32" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="↪ 插话"
                                Command="{Binding SteerCommand}"
                                ToolTip.Tip="入队插话（队列满/无会话时如实提示）" />
                    </Grid>
                    <!-- R4-γ：附件预览条（有待附件时显示） -->
                    <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                  IsVisible="{Binding !!PendingAttachments.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MessageAttachment">
                                <Border Background="{DynamicResource ChatPanel}"
                                        CornerRadius="6" Padding="8,4" Margin="0,0,6,4"
                                        BorderBrush="{DynamicResource ChatBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding FileName}" FontSize="11"
                                                   Foreground="{DynamicResource ChatFg}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource ChatMuted}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="DisplaySize" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Content="✕" FontSize="9" Padding="2"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource ChatRed}"
                                                ToolTip.Tip="移除附件" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Button Grid.Column="0" Content="附件"
                                Command="{Binding AttachFileCommand}"
                                ToolTip.Tip="添加附件（任意类型，最多 100 个 / 合计 10GB）"
                                Background="Transparent" BorderThickness="0"
                                FontSize="13" Padding="8,4"
                                Foreground="{DynamicResource ChatMuted}"
                                VerticalAlignment="Bottom" />
                        <TextBox Grid.Column="1" x:Name="InputBox"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="输入消息，Enter 发送，Shift+Enter 换行，Ctrl+V 粘贴图片…"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="44" MaxHeight="160" FontSize="14"
                                 KeyDown="OnInputKeyDown" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="停止"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsStreaming}" />
                        <Button Grid.Column="3" Margin="8,0,0,0" Content="入队"
                                Command="{Binding EnqueueCommand}"
                                ToolTip.Tip="把指令加入队列，逐条自动执行" />
                        <Button Grid.Column="4" Margin="8,0,0,0" Content="发送" Classes="Primary"
                                Command="{Binding SendCommand}" />
                    </Grid>
                    <!-- 指令队列（UIR-5 铺全输入框）：DataContext = Queue 引擎 -->
                    <views:CommandQueueView DataContext="{Binding Queue}"
                                            AutomationProperties.AutomationId="ChatQueuePanel" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
