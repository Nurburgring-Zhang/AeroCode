<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             xmlns:conv="using:AeroCode.App.Converters"
             x:Class="AeroCode.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <UserControl.Resources>
        <conv:MarkdownToControlConverter x:Key="MdToControl" />
        <conv:BoolToOpacityConverter x:Key="StreamingOpacity" />
        <SolidColorBrush x:Key="ChatBg" Color="#0B0D12"/>
        <SolidColorBrush x:Key="ChatPanel" Color="#11141B"/>
        <SolidColorBrush x:Key="ChatElevated" Color="#161A23"/>
        <SolidColorBrush x:Key="ChatBorder" Color="#2A3142"/>
        <SolidColorBrush x:Key="ChatFg" Color="#E5E9F0"/>
        <SolidColorBrush x:Key="ChatMuted" Color="#8A93A6"/>
        <SolidColorBrush x:Key="ChatAccent" Color="#7C3AED"/>
        <SolidColorBrush x:Key="ChatCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="ChatRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="ChatUserBubble" Color="#2A2153"/>
        <SolidColorBrush x:Key="ChatAiBubble" Color="#161A23"/>
    </UserControl.Resources>

    <Grid ColumnDefinitions="260,*" Background="{StaticResource ChatBg}">

        <!-- 左栏：会话列表 + todo 清单 -->
        <Border Grid.Column="0" Background="{StaticResource ChatPanel}"
                BorderBrush="{StaticResource ChatBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" Margin="10" HorizontalAlignment="Stretch"
                        Content="＋ 新会话" Command="{Binding NewSessionCommand}" />

                <!-- 待办清单（G5）：当前会话 TodoStore 条目，勾选/删除真实落库 -->
                <Border DockPanel.Dock="Bottom" MaxHeight="230"
                        BorderBrush="{StaticResource ChatBorder}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="✅ 待办清单" Margin="10,8,10,4"
                                   FontWeight="SemiBold" Foreground="{StaticResource ChatAccent}" FontSize="12" />
                        <ListBox ItemsSource="{Binding Todos}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodoItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  ToolTip.Tip="勾选/取消完成（真实落库）"
                                                  Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).ToggleTodoCommand}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{StaticResource ChatFg}" />
                                        <Button Grid.Column="2" Content="🗑" FontSize="10" Padding="3"
                                                VerticalAlignment="Center" ToolTip.Tip="删除待办"
                                                Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).DeleteTodoCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="2">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource ChatFg}"
                                               FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource ChatMuted}" FontSize="10" />
                                        <TextBlock Text="{Binding Strategy}" Foreground="{StaticResource ChatCyan}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Content="📌" FontSize="10" Padding="3"
                                            ToolTip.Tip="置顶/取消置顶"
                                            Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).TogglePinCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="🌿" FontSize="10" Padding="3"
                                            ToolTip.Tip="分叉会话（复制元数据与全部消息为新会话，标题带 fork）"
                                            Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).ForkSessionCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="🗑" FontSize="10" Padding="3"
                                            ToolTip.Tip="删除会话"
                                            Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).DeleteSessionCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右区：消息流 + 输入 -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- 消息流 -->
            <ScrollViewer x:Name="MessageScroller" Grid.Row="0" Padding="16,12"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItemViewModel">
                            <Grid Margin="0,6" ColumnDefinitions="*,Auto,*">
                                <!-- 用户消息靠右 -->
                                <Border Grid.Column="2" IsVisible="{Binding IsUser}"
                                        Background="{StaticResource ChatUserBubble}"
                                        CornerRadius="12,12,2,12" Padding="12,8"
                                        MaxWidth="560" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               Foreground="{StaticResource ChatFg}" FontSize="14" />
                                </Border>

                                <!-- 工具结果消息：紧凑行（徽章 + 参数 + 输出） -->
                                <StackPanel Grid.Column="0" IsVisible="{Binding IsTool}"
                                            Margin="{Binding IndentMargin}"
                                            MaxWidth="680" HorizontalAlignment="Left" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{StaticResource ChatCyan}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding ToolBadge}" FontSize="10"
                                                       Foreground="#04121A" />
                                        </Border>
                                        <TextBlock Text="{Binding StatusGlyph}" IsVisible="{Binding !!StatusGlyph}"
                                                   Foreground="{StaticResource ChatRed}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{StaticResource ChatPanel}"
                                            CornerRadius="2,10,10,10" Padding="10,6"
                                            BorderBrush="{StaticResource ChatBorder}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding ToolArguments}"
                                                       IsVisible="{Binding !!ToolArguments}"
                                                       Foreground="{StaticResource ChatMuted}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ToolArguments}" />
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource ChatFg}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 助手消息靠左；MOA 归属树按父级深度缩进 -->
                                <StackPanel Grid.Column="0" IsVisible="{Binding IsAssistant}"
                                            Margin="{Binding IndentMargin}"
                                            MaxWidth="680" HorizontalAlignment="Left" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{StaticResource ChatAccent}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!AttributionBadge}">
                                            <TextBlock Text="{Binding AttributionBadge}" FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                        <Border Background="{StaticResource ChatCyan}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!Label}">
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="#04121A" />
                                        </Border>
                                        <Border Background="{StaticResource ChatBorder}" CornerRadius="6"
                                                Padding="6,2" IsVisible="{Binding !!ToolCallsBadge}">
                                            <TextBlock Text="{Binding ToolCallsBadge}" FontSize="10"
                                                       Foreground="{StaticResource ChatFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding StatusGlyph}" IsVisible="{Binding !!StatusGlyph}"
                                                   Foreground="{StaticResource ChatRed}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UsageBadge}" IsVisible="{Binding !!UsageBadge}"
                                                   Foreground="{StaticResource ChatMuted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CostBadge}" IsVisible="{Binding !!CostBadge}"
                                                   Foreground="{StaticResource ChatMuted}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{StaticResource ChatAiBubble}"
                                            CornerRadius="2,12,12,12" Padding="12,8"
                                            BorderBrush="{StaticResource ChatBorder}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding ReasoningContent}" IsVisible="{Binding !!ReasoningContent}"
                                                       Foreground="{StaticResource ChatMuted}" FontSize="11"
                                                       FontStyle="Italic" TextWrapping="Wrap" />
                                            <ContentControl Content="{Binding Content, Converter={StaticResource MdToControl}}" />
                                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding !!ErrorText}"
                                                       Foreground="{StaticResource ChatRed}" FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 输入区 -->
            <Border Grid.Row="1" Background="{StaticResource ChatPanel}"
                    BorderBrush="{StaticResource ChatBorder}" BorderThickness="0,1,0,0" Padding="12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Provider" Foreground="{StaticResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding ProviderIds}"
                                      SelectedItem="{Binding SelectedProviderId, Mode=TwoWay}"
                                      MinWidth="140" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="策略" Foreground="{StaticResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Strategies}"
                                      SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                      ToolTip.Tip="本会话编排策略：Single 单模型 / Router 路由分流 / Decompose 拆解分工 / Ensemble 多模型集成 / Pipeline 起草-评审-修订 / Experts 专家团（经 moa-gateway-pro 网关多专家编排，网关不可达时该轮诚实失败）"
                                      MinWidth="110" FontSize="12" />
                            <TextBlock Text="{Binding ExpertsGatewayHint}"
                                       IsVisible="{Binding IsExpertsSelected}"
                                       Foreground="{StaticResource ChatMuted}" FontSize="10"
                                       MaxWidth="320" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                            <TextBlock Text="档位" Foreground="{StaticResource ChatMuted}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PermissionModes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                      MinWidth="104" FontSize="12"
                                      ToolTip.Tip="权限档位：Default 逐工具规则 / AcceptEdits 自动接受编辑 / Plan 只读规划（write_plan 落 PLAN.md）/ Bypass 跳过询问（显式拒绝与危险命令拦截不受影响）" />
                            <TextBlock Text="{Binding ModeDescription}" Foreground="{StaticResource ChatMuted}"
                                       FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                   Foreground="{StaticResource ChatMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0" />
                    </Grid>
                    <!-- Steer 插话（G5）：流式进行中可见，经 SteerQueue 下一轮注入 -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStreaming}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SteerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="插话（Steer）：流式进行中输入，下一轮注入…"
                                 FontSize="12" MinHeight="32" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="↪ 插话"
                                Command="{Binding SteerCommand}"
                                ToolTip.Tip="入队插话（队列满/无会话时如实提示）" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" x:Name="InputBox"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="输入消息，Enter 发送，Shift+Enter 换行…"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="44" MaxHeight="160" FontSize="14"
                                 KeyDown="OnInputKeyDown" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="⏹ 停止"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsStreaming}" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="🚀 发送"
                                Command="{Binding SendCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
