<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             xmlns:models="using:AeroCode.Core.Models"
             xmlns:views="using:AeroCode.App.Views"
             xmlns:conv="using:AeroCode.App.Converters"
             x:Class="AeroCode.App.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <!-- R5 简约现代重构：中心主题令牌（AppColors.axaml）+ 左侧边栏导航。
         绑定纪律：禁用类型转换绑定（R4.2 事故教训），一律反射安全形式。 -->
    <UserControl.Resources>
        <conv:DateTimeFormatConverter x:Key="DateFmt" />
        <conv:BoolToBrushConverter x:Key="PinBrush" />
        <conv:StringNotEmptyToBoolConverter x:Key="HasText" />
        <conv:CountToBoolConverter x:Key="HasCount" />
        <conv:IndexEqualsToBoolConverter x:Key="Idx" />
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNoteCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNoteCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding SaveNoteCommand}" />
    </UserControl.KeyBindings>

    <Grid>
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧边栏：品牌 + 导航 + 底部设置/主题 -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- 品牌区 + 收起按钮 -->
                    <Grid DockPanel.Dock="Top" Margin="16,18,10,14" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Image Source="/Assets/aerocode-brand-128.png" Width="26" Height="26"
                                   VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="AeroCode" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgPrimary}" />
                                <TextBlock Text="本地优先 · AI 工作台" FontSize="11"
                                           Foreground="{DynamicResource FgMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="◀" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Top" Padding="6,2" FontSize="12"
                                ToolTip.Tip="收起侧边栏" Click="OnCollapseSidebarClick" />
                    </Grid>

                    <!-- 底部：设置 / 主题 / 退出（上移远离底边） -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,28" Spacing="4">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Content="设置" Click="OnOpenSettingsClick" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Content="切换主题" Click="OnCycleThemeClick"
                                ToolTip.Tip="Light / Dark / System 循环切换" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Content="退出" Click="OnExitClick"
                                ToolTip.Tip="退出 AeroCode" />
                    </StackPanel>

                    <!-- 导航列表 -->
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Padding="8,7" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右区：工具条 + 内容面板 + 状态栏 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Background="{DynamicResource BgDeep}">

                <!-- 顶部 slim 工具条 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,0,1" Padding="14,9">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" x:Name="ExpandSidebarButton" Content="☰" IsVisible="False"
                                Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="14"
                                ToolTip.Tip="展开侧边栏" Click="OnExpandSidebarClick" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" x:Name="SearchBox" MaxWidth="360"
                                 HorizontalAlignment="Left" Width="360"
                                 Watermark="搜索笔记…"
                                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Content="新建笔记"
                                Command="{Binding CreateNoteCommand}" />
                    </Grid>
                </Border>

                <!-- 内容面板（按导航索引切换；视图实例常驻，切换不丢状态） -->
                <Grid Grid.Row="1">

                    <!-- 0 笔记 -->
                    <Grid AutomationProperties.AutomationId="NavPanel0" IsVisible="{Binding SelectedNavIndex, Converter={StaticResource Idx}, ConverterParameter=1}"
                          ColumnDefinitions="320,6,*">
                        <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="笔记" Padding="14,10"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource FgMuted}" />
                                <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:Note">
                                            <Border Padding="10,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="{Binding IsPinned, Converter={StaticResource PinBrush}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource DateFmt}}" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                                                    <TextBlock Text="{Binding Content}" Foreground="{DynamicResource FgMuted}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource Border}" ResizeDirection="Columns" />

                        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBox Grid.Column="0" Watermark="笔记标题…" FontSize="18" FontWeight="SemiBold" Background="Transparent" BorderThickness="0"
                                             Text="{Binding SelectedNote.Title, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Content="置顶" Command="{Binding TogglePinCommand}" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" Content="保存" Classes="Primary" Command="{Binding SaveNoteCommand}" />
                                    <Button Grid.Column="3" Margin="6,0,0,0" Content="删除" Command="{Binding DeleteNoteCommand}" />
                                </Grid>
                            </Border>
                            <!-- 笔记内 AI（AIF-1）：对当前笔记的真实 LLM 操作 -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                    Padding="16,8" Background="{DynamicResource BgPanel}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBox Grid.Column="0" Watermark="问这篇笔记 / 输入指令…（Enter 发送，Shift+Enter 换行）" FontSize="12"
                                                 AutomationProperties.AutomationId="NoteAiInput"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MaxHeight="96"
                                                 Text="{Binding NoteAiInput, Mode=TwoWay}"
                                                 KeyDown="OnNoteAiInputKeyDown" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" Content="问答" Command="{Binding NoteAiAskCommand}"
                                                AutomationProperties.AutomationId="NoteAiAsk" IsEnabled="{Binding !IsNoteAiBusy}" />
                                        <Button Grid.Column="2" Margin="6,0,0,0" Content="分析" Command="{Binding NoteAiAnalyzeCommand}"
                                                AutomationProperties.AutomationId="NoteAiAnalyze" IsEnabled="{Binding !IsNoteAiBusy}" />
                                        <Button Grid.Column="3" Margin="6,0,0,0" Content="整理" Command="{Binding NoteAiOrganizeCommand}"
                                                AutomationProperties.AutomationId="NoteAiOrganize" IsEnabled="{Binding !IsNoteAiBusy}" />
                                        <Button Grid.Column="4" Margin="6,0,0,0" Content="摘要" Command="{Binding NoteAiSummarizeCommand}"
                                                AutomationProperties.AutomationId="NoteAiSummarize" IsEnabled="{Binding !IsNoteAiBusy}" />
                                        <Button Grid.Column="5" Margin="6,0,0,0" Content="应用到笔记" Command="{Binding NoteAiApplyCommand}"
                                                AutomationProperties.AutomationId="NoteAiApply" IsEnabled="{Binding !IsNoteAiBusy}" />
                                        <Button Grid.Column="6" Margin="6,0,0,0" Content="入队" Command="{Binding EnqueueNoteAiCommand}"
                                                AutomationProperties.AutomationId="NoteAiEnqueue"
                                                ToolTip.Tip="把指令加入队列，逐条自动执行" />
                                    </Grid>
                                    <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                                             AutomationProperties.AutomationId="NoteAiResult"
                                             Watermark="AI 结果将显示在这里（流式）…" FontSize="12" Padding="8"
                                             Background="{DynamicResource BgDeep}"
                                             Text="{Binding NoteAiResult}" />
                                    <!-- 指令队列（UIR-5 铺全输入框）：DataContext = NoteAiQueue 引擎 -->
                                    <views:CommandQueueView DataContext="{Binding NoteAiQueue}"
                                                            AutomationProperties.AutomationId="NoteAiQueuePanel" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2" ColumnDefinitions="*,6,*">
                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="编辑" Padding="14,6"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgMuted}" />
                                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,JetBrains Mono,monospace" FontSize="13" Padding="12" Background="{DynamicResource BgPanel}"
                                             AutomationProperties.AutomationId="NoteContentEditor"
                                             Text="{Binding SelectedNote.Content, Mode=TwoWay}" />
                                </DockPanel>
                                <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource Border}" ResizeDirection="Columns" />
                                <DockPanel Grid.Column="2">
                                    <views:MarkdownPreviewView x:Name="PreviewView" />
                                </DockPanel>
                            </Grid>
                            <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,6">
                                <TextBlock FontSize="11" Foreground="{DynamicResource FgMuted}">
                                    <Run Text="ID: " /><Run Text="{Binding SelectedNote.Id, FallbackValue='-'}" />
                                    <Run Text="字数: " /><Run Text="{Binding SelectedNote.WordCount, FallbackValue=0}" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 2 AI 助手 -->
                    <!-- 面板切换修复：IsVisible 必须挂在继承 MainView DataContext 的容器上——
                         子视图自身 DataContext 是各自 VM，直接绑 SelectedNavIndex 会静默失败、
                         面板恒可见并互相遮盖（点击导航"没反应"的根因）。 -->
                    <Panel AutomationProperties.AutomationId="NavPanel1" IsVisible="{Binding SelectedNavIndex, Converter={StaticResource Idx}, ConverterParameter=2}">
                        <views:AIAssistantView />
                    </Panel>
                    <!-- 0 对话（置顶） -->
                    <Panel AutomationProperties.AutomationId="NavPanel2" IsVisible="{Binding SelectedNavIndex, Converter={StaticResource Idx}, ConverterParameter=0}">
                        <views:ChatView />
                    </Panel>
                    <!-- 3 Mission -->
                    <Panel AutomationProperties.AutomationId="NavPanel3" IsVisible="{Binding SelectedNavIndex, Converter={StaticResource Idx}, ConverterParameter=3}">
                        <views:MissionView />
                    </Panel>
                    <!-- 4 代码评审 -->
                    <Panel AutomationProperties.AutomationId="NavPanel6" IsVisible="{Binding SelectedNavIndex, Converter={StaticResource Idx}, ConverterParameter=4}">
                        <views:CodeReviewView />
                    </Panel>
                </Grid>

                <!-- 底部状态栏 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0" Padding="14,6">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgMuted}" FontSize="12" />
                </Border>
            </Grid>
        </Grid>

        <!-- 覆盖层宿主：single-view 平台（Android）无 Window，设置/授权/消息对话框经 OverlayService 挂载于此 -->
        <Panel x:Name="OverlayRoot" />
    </Grid>
</UserControl>
