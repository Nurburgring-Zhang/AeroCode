<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             x:Class="AeroCode.App.Views.CodeReviewView"
             x:DataType="vm:CodeReviewViewModel">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,6,*" Background="{DynamicResource BgDeep}">
        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="V3 Code Review" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           Foreground="{DynamicResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
                <Button Grid.Column="2" Content="选文件" Command="{Binding PickFileCommand}" />
                <Button Grid.Column="3" Content="▶ Review" Margin="6,0,0,0"
                        Command="{Binding ReviewCommand}" Background="{DynamicResource Accent}" />
                <Button Grid.Column="4" Content="⚔ 对抗评审" Margin="6,0,0,0"
                        Command="{Binding AdversarialReviewCommand}"
                        ToolTip.Tip="批评者→辩护者→裁判 三角色对抗评审（真实 LLM）"
                        Background="{DynamicResource Danger}" />
                <Button Grid.Column="5" Content="清空" Margin="6,0,0,0"
                        Command="{Binding ClearCommand}" />
            </Grid>
        </Border>

        <!-- Source code panel -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="源代码" Padding="14,10,14,4"
                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedFilePath}"
                       Padding="14,0,14,6" Foreground="{DynamicResource FgMuted}" FontSize="11" />
            <TextBox Text="{Binding SourceCode, Mode=TwoWay}"
                     FontFamily="Consolas,JetBrains Mono,monospace" FontSize="12"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     Background="{DynamicResource BgPanel}" Foreground="{DynamicResource FgPrimary}"
                     Padding="14" />
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6"
                       Background="{DynamicResource Border}" ResizeDirection="Columns" />

        <!-- Report panel -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="8 维度 Review 报告" Padding="14,10,14,4"
                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
            <ScrollViewer Padding="14" Background="{DynamicResource BgPanel}">
                <TextBlock Text="{Binding ReportText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource FgPrimary}" FontSize="13"
                           FontFamily="Consolas,JetBrains Mono,monospace" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
