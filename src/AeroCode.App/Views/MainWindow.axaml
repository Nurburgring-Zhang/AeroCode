<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AeroCode.App.ViewModels"
        xmlns:models="using:AeroCode.Core.Models"
        xmlns:views="using:AeroCode.App.Views"
        xmlns:conv="using:AeroCode.App.Converters"
        x:Class="AeroCode.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AeroCode · 本地优先笔记 + AI 助手 + Agent Harness (V3.0)"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:DateTimeFormatConverter x:Key="DateFmt" />
        <conv:BoolToBrushConverter x:Key="PinBrush" />
        <conv:StringNotEmptyToBoolConverter x:Key="HasText" />
        <conv:CountToBoolConverter x:Key="HasCount" />
        <SolidColorBrush x:Key="BgDeep" Color="#0B0D12"/>
        <SolidColorBrush x:Key="BgPanel" Color="#11141B"/>
        <SolidColorBrush x:Key="BgElevated" Color="#161A23"/>
        <SolidColorBrush x:Key="Border" Color="#2A3142"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#E5E9F0"/>
        <SolidColorBrush x:Key="FgMuted" Color="#8A93A6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentPink" Color="#EC4899"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNoteCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNoteCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding SaveNoteCommand}" />
    </Window.KeyBindings>

    <DockPanel LastChildFill="True">
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="📒 AeroCode" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="V3.0 · 8 项目深度集成 · Hermes + OpenCode + DSH + Reasonix + MattPocock + eng-practices + CodeFlow + Avernet"
                           Foreground="{StaticResource FgMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="2" x:Name="SearchBox" Width="280" Watermark="🔍 搜索 (Ctrl+F)"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Margin="8,0,0,0" Content="📝 新笔记" Command="{Binding CreateNoteCommand}" />
                <Button Grid.Column="4" Margin="8,0,0,0" Content="📁 新笔记本" Command="{Binding CreateNotebookCommand}" />
                <Button Grid.Column="5" Margin="8,0,0,0" Content="⚙️ 设置" Click="OnOpenSettingsClick" />
                <Button Grid.Column="6" Margin="8,0,0,0" Content="🌓 主题" Click="OnCycleThemeClick" ToolTip.Tip="快速切换 Light / Dark / System" />
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgMuted}" FontSize="12" />
        </Border>

        <TabControl Background="{StaticResource BgDeep}">
            <TabItem Header="📒 笔记" Foreground="{StaticResource AccentPurple}">
                <Grid ColumnDefinitions="240,340,*">
                    <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="*,Auto,Auto,*">
                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Top" Text="📚 笔记本" Padding="12,10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                                <ListBox ItemsSource="{Binding Notebooks}" SelectedItem="{Binding SelectedNotebook, Mode=TwoWay}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:Notebook">
                                            <TextBlock Text="{Binding Name}" Padding="8,6" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource Border}" />
                            <TextBlock Grid.Row="2" Text="🏷️ 标签" Padding="12,10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />
                            <ListBox Grid.Row="3" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:Tag">
                                        <TextBlock Text="{Binding Name}" Padding="8,6" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📄 笔记" Padding="12,10" FontWeight="SemiBold" Foreground="{StaticResource AccentPink}" />
                            <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:Note">
                                        <Border Padding="10,8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="{Binding IsPinned, Converter={StaticResource PinBrush}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource DateFmt}}" Foreground="{StaticResource FgMuted}" FontSize="11" />
                                                <TextBlock Text="{Binding Content}" Foreground="{StaticResource FgMuted}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBox Grid.Column="0" Watermark="笔记标题..." FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                         Text="{Binding SelectedNote.Title, Mode=TwoWay}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Content="📌 置顶" Command="{Binding TogglePinCommand}" />
                                <Button Grid.Column="2" Margin="6,0,0,0" Content="💾 保存 (Ctrl+S)" Command="{Binding SaveNoteCommand}" />
                                <Button Grid.Column="3" Margin="6,0,0,0" Content="🗑️ 删除" Command="{Binding DeleteNoteCommand}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,6,*">
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="✏️ 编辑 (Markdown)" Padding="12,6" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}" />
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas,JetBrains Mono,monospace" FontSize="13" Padding="12" Background="{StaticResource BgPanel}"
                                         Text="{Binding SelectedNote.Content, Mode=TwoWay}" />
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="6" Background="{StaticResource Border}" ResizeDirection="Columns" />
                            <DockPanel Grid.Column="2">
                                <views:MarkdownPreviewView x:Name="PreviewView" />
                            </DockPanel>
                        </Grid>
                        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6">
                            <TextBlock FontSize="11" Foreground="{StaticResource FgMuted}">
                                <Run Text="ID: " /><Run Text="{Binding SelectedNote.Id, FallbackValue='-'}" />
                                <Run Text="  字数: " /><Run Text="{Binding SelectedNote.WordCount, FallbackValue=0}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🤖 AI 助手" Foreground="{StaticResource AccentCyan}">
                <views:AIAssistantView />
            </TabItem>

            <TabItem Header="💬 统一对话" Foreground="{StaticResource AccentGreen}">
                <views:ChatView />
            </TabItem>

            <TabItem Header="🎯 Skills (V3)" Foreground="{StaticResource AccentPurple}">
                <views:SkillsView />
            </TabItem>

            <TabItem Header="🧠 Memory (V3)" Foreground="{StaticResource AccentAmber}">
                <views:MemoryView />
            </TabItem>

            <TabItem Header="🔍 Code Review (V3)" Foreground="{StaticResource AccentCyan}">
                <views:CodeReviewView />
            </TabItem>

            <TabItem Header="📊 Diagnostics (V3)" Foreground="{StaticResource AccentGreen}">
                <views:DiagnosticsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
