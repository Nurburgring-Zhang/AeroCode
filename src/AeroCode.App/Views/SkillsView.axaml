<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             x:Class="AeroCode.App.Views.SkillsView"
             x:DataType="vm:SkillsViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BgDeep" Color="#0B0D12"/>
        <SolidColorBrush x:Key="BgPanel" Color="#11141B"/>
        <SolidColorBrush x:Key="BgElevated" Color="#161A23"/>
        <SolidColorBrush x:Key="Border" Color="#2A3142"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#E5E9F0"/>
        <SolidColorBrush x:Key="FgMuted" Color="#8A93A6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Background="{StaticResource BgDeep}">
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="🎯 V3 Skills" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="14,0"/>
                <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                <TextBox Grid.Column="3" Width="220" Margin="6,0,0,0" Watermark="🔍 搜索 Skill..."
                         Text="{Binding FilterText, Mode=TwoWay}" />
                <Button Grid.Column="4" Margin="6,0,0,0" Content="🔄 刷新"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1" Background="{StaticResource BgElevated}" Margin="14,12,14,0"
              ColumnDefinitions="2*,3*,1*,1*,1*,1*">
            <TextBlock Grid.Column="0" Text="Skill (Id · Name)" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="1" Text="Description" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="2" Text="Category" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="3" Text="Author" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="4" Text="Invocations" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Grid.Column="5" Text="Success %" Padding="6,8"
                       Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="11" />
        </Grid>

        <ScrollViewer Grid.Row="2" Padding="14,8,14,14">
            <ItemsControl ItemsSource="{Binding FilteredSkills}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SkillRow">
                        <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Grid ColumnDefinitions="2*,3*,1*,1*,1*,1*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentCyan}"
                                               FontFamily="Consolas,monospace" FontSize="12" />
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource FgPrimary}"
                                               FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Description}"
                                           Foreground="{StaticResource FgPrimary}" FontSize="12"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                                        Background="{StaticResource AccentPurple}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Category}" Foreground="White" FontSize="10" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Author}"
                                           Foreground="{StaticResource FgMuted}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Invocations}"
                                           Foreground="{StaticResource AccentGreen}" FontSize="14"
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5"
                                           Text="{Binding SuccessRate, StringFormat={}{0:P0}}"
                                           Foreground="{StaticResource AccentAmber}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
