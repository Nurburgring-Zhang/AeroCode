<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AeroCode.App.ViewModels"
        xmlns:cfg="using:AeroCode.AI.Configuration"
        x:Class="AeroCode.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="⚙️ AeroCode Settings"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True" MinWidth="700" MinHeight="500">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel" Color="#11141B" />
        <SolidColorBrush x:Key="BgElev" Color="#161A23" />
        <SolidColorBrush x:Key="Border" Color="#2A3142" />
        <SolidColorBrush x:Key="FgPrimary" Color="#E5E9F0" />
        <SolidColorBrush x:Key="FgMuted" Color="#8A93A6" />
        <SolidColorBrush x:Key="AccentPurple" Color="#7C3AED" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />
        <SolidColorBrush x:Key="AccentPink" Color="#EC4899" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="⚙️ AeroCode 全局设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" />
                <TextBlock Text="配置 AI Provider、UI 主题、内存上限等。所有变更持久化到 settings.json。"
                           Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource FgMuted}" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="🏥 Health" Command="{Binding HealthCheckAllCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="🔄 Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="❌ Cancel" Click="OnCancelClick" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="💾 Save" Command="{Binding SaveCommand}" Background="{StaticResource AccentGreen}" Foreground="White" />
            </Grid>
        </Border>

        <ScrollViewer Background="{StaticResource BgElev}">
            <StackPanel Spacing="16" Margin="20">

                <!-- ====================== UI 主题与外观 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🎨 UI 外观" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                        <Grid ColumnDefinitions="160,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="主题 (Theme)" Foreground="{StaticResource FgPrimary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="160,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="字体大小 (pt)" Foreground="{StaticResource FgPrimary}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Value="{Binding FontSize, Mode=TwoWay}" Minimum="10" Maximum="22" Increment="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====================== AI Provider 默认 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🤖 AI Provider 默认值" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}" />
                        <Grid ColumnDefinitions="160,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="默认 Provider" Foreground="{StaticResource FgPrimary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableProviderIds}"
                                      SelectedItem="{Binding DefaultProviderId, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="默认模型" Foreground="{StaticResource FgPrimary}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DefaultModel, Mode=TwoWay}" Watermark="deepseek-v4-flash" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====================== Provider 列表 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="📡 Provider 列表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}" />
                            <Button Grid.Column="1" Content="➕ Add" Command="{Binding AddProviderCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="➖ Remove" Command="{Binding RemoveSelectedProviderCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" Background="Transparent" MinHeight="100">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="cfg:ProviderConfig">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                                        <StackPanel Grid.Column="0" Margin="6,4,0,4">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="10" Foreground="{StaticResource FgMuted}">
                                                <Run Text="{Binding Id}" /><Run Text=" · " /><Run Text="{Binding BaseUrl}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource FgMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 编辑区 -->
                        <Border IsVisible="{Binding SelectedProvider, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource BgElev}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="✏️ Provider 详情" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="🔌 测试连通" Command="{Binding TestSelectedProviderCommand}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Id" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.Id, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="显示名" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.DisplayName, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="协议" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedProvider.Kind, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <x:String>OpenAICompatible</x:String>
                                        <x:String>AnthropicMessages</x:String>
                                        <x:String>Custom</x:String>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="Base URL" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.BaseUrl, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="默认模型" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.DefaultModel, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="API Key Env" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.ApiKeyEnvVar, Mode=TwoWay}" Watermark="DEEPSEEK_API_KEY" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="超时 (s)" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedProvider.TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" Increment="5" />
                                </Grid>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding SelectedProvider.RequiresApiKey, Mode=TwoWay}" Content="需要从环境变量读 API Key" />
                                <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding SelectedProvider.SupportsStreaming, Mode=TwoWay}" Content="支持流式" Margin="0,0,16,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SelectedProvider.SupportsToolCalling, Mode=TwoWay}" Content="支持工具调用" Margin="0,0,16,0" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding SelectedProvider.SupportsThinking, Mode=TwoWay}" Content="支持深度思考" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="思考强度档" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProvider.ThinkingEfforts, Mode=TwoWay}" Watermark="low,medium,high（逗号分隔，留空 = provider 默认）" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="ExtraHeaders" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding ExtraHeadersJson, Mode=TwoWay}"
                                              AcceptsReturn="True" MinHeight="54" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                              Watermark='{}{"X-Custom-Header": "value"}（JSON 对象，值必须为字符串）' />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="ExtraBody" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding ExtraBodyJson, Mode=TwoWay}"
                                              AcceptsReturn="True" MinHeight="54" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                              Watermark='{}{"reasoning_split": true}（JSON 对象，值任意类型，原样合并进请求 body）' />
                                </Grid>
                                <TextBlock Text="ExtraHeaders / ExtraBody 在切换 Provider 与保存时做 JSON 校验；非法文本会保留原文并阻止保存。"
                                           Foreground="{StaticResource FgMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ====================== 工具权限 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🔐 工具权限" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="11"
                                   Text="模型调用工具前的授权策略：允许 = 直接执行；拒绝 = 永不执行（原因如实返回给模型）；每次询问 = 弹窗确认。修改随 Save 生效并持久化到 permissions.json。危险模式探测（如 run_shell 的 rm/format）不受降级影响。" />
                        <ItemsControl ItemsSource="{Binding PermissionRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PermissionRuleItem">
                                    <Grid ColumnDefinitions="190,*,170" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding ToolName}"
                                                   Foreground="{StaticResource FgPrimary}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Notes}"
                                                   Foreground="{StaticResource FgMuted}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="8,0" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DecisionChoices}"
                                                  SelectedItem="{Binding Decision, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:DecisionChoice">
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ====================== 模型画像 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="🧬 模型画像" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentPurple}" />
                            <Button Grid.Column="1" Content="➕ Add" Command="{Binding AddProfileCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="➖ Remove" Command="{Binding RemoveSelectedProfileCommand}" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="11"
                                   Text="画像供 MOA 路由分配：强项决定子任务去向，上下文/成本/速度参与打分与预算核算。成本留空 = 未知（核算时跳过，绝不估算）；调用统计为运行时自学习，只读。保存后写入 moa-profiles.json 并立即生效。" />
                        <ListBox ItemsSource="{Binding ProfileEditors}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Background="Transparent" MinHeight="90">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileEditorItem">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12">
                                            <Run Text="{Binding ProviderId}" /><Run Text=" :: " /><Run Text="{Binding ModelId}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding StatsText}" Foreground="{StaticResource FgMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 画像编辑区 -->
                        <Border IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource BgElev}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="✏️ 画像详情" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" />
                                <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Provider Id" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProfile.ProviderId, Mode=TwoWay}" Watermark="deepseek" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="模型 Id" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProfile.ModelId, Mode=TwoWay}" Watermark="留空 = 该 provider 的默认模型画像" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="上下文窗口" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedProfile.ContextWindow, Mode=TwoWay}" Minimum="0" Maximum="10000000" Increment="1024" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="最大输出 tok" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedProfile.MaxOutputTokens, Mode=TwoWay}" Minimum="0" Maximum="10000000" Increment="256" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*,16,120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="输入 $/M tok" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="1" Text="{Binding SelectedProfile.CostInText, Mode=TwoWay}" Watermark="留空 = 未知" />
                                    <TextBlock Grid.Column="3" Text="输出 $/M tok" VerticalAlignment="Center" />
                                    <TextBox  Grid.Column="4" Text="{Binding SelectedProfile.CostOutText, Mode=TwoWay}" Watermark="留空 = 未知" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*" Margin="0,6,0,0">
                                    <TextBlock Grid.Column="0" Text="速度档" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SelectedProfile.SpeedChoices}"
                                              SelectedItem="{Binding SelectedProfile.Speed, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vm:SpeedChoice">
                                                <TextBlock Text="{Binding Display}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="强项（多选）" Margin="0,8,0,0" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding SelectedProfile.Strengths}" Margin="120,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:StrengthToggle">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" Margin="0,0,16,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap">
                                    <Run Text="📊 运行统计（只读）：" /><Run Text="{Binding SelectedProfile.StatsText}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ====================== MOA 编排策略 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🧭 MOA 编排策略" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentPink}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="11"
                                   Text="默认策略用于新建会话（会话内仍可单独切换）；四角色绑定固定由哪个模型承担对应环节，自动分配 = 按画像强项打分指派。Ensemble 规模为集成策略并行作答的模型数（2-4）；单轮预算只统计已计价调用，留空 = 不限制。保存写入 moa-options.json 并立即热生效，无需重启。" />
                        <Grid ColumnDefinitions="140,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="默认策略" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StrategyChoices}" SelectedItem="{Binding DefaultStrategy, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="Router 绑定" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleBindingChoices}" SelectedItem="{Binding RouterChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RoleBindingChoice">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="Planner 绑定" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleBindingChoices}" SelectedItem="{Binding PlannerChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RoleBindingChoice">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="Synthesizer 绑定" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleBindingChoices}" SelectedItem="{Binding SynthesizerChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RoleBindingChoice">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="Judge 绑定" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleBindingChoices}" SelectedItem="{Binding JudgeChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RoleBindingChoice">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="Ensemble 规模" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding EnsembleSize, Mode=TwoWay}" Minimum="2" Maximum="4" Increment="1" />
                        </Grid>
                        <Grid ColumnDefinitions="140,*" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0" Text="单轮预算 (USD)" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <TextBox Grid.Column="1" Text="{Binding MaxUsdText, Mode=TwoWay}" Watermark="留空 = 不限制（仅已计价调用计入）" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ToolsEnabled, Mode=TwoWay}" Content="启用工具循环（worker 携带工具多轮执行）" Margin="140,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ====================== Memory 上限 ====================== -->
                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🧠 Memory 容量" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentAmber}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMuted}" FontSize="11"
                                   Text="MEMORY.md / USER.md 是 Hermes 风格 agent 长期记忆。超过上限会被截断,默认 2200 / 1375 (Hermes 推荐值)。" />
                        <Grid ColumnDefinitions="160,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="MEMORY.md 上限" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding MemoryMaxChars, Mode=TwoWay}" Minimum="200" Maximum="20000" Increment="100" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="USER.md 上限" VerticalAlignment="Center" Foreground="{StaticResource FgPrimary}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding UserProfileMaxChars, Mode=TwoWay}" Minimum="200" Maximum="10000" Increment="100" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
