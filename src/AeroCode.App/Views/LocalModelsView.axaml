<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             xmlns:conv="using:AeroCode.App.Converters"
             x:Class="AeroCode.App.Views.LocalModelsView"
             x:DataType="vm:LocalModelsViewModel">

    <UserControl.Resources>
        <conv:GatewayStatusBrushConverter x:Key="ReachableBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="4">

            <!-- 运行时状态 + 检测/更新 -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="本地模型运行时（Ollama）" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        <Button Grid.Column="1" Content="检测" Command="{Binding RefreshCommand}"
                                Margin="0,0,8,0" ToolTip.Tip="探测 Ollama 是否运行、版本与已装模型" />
                        <Button Grid.Column="2" Content="检查更新" Command="{Binding CheckForUpdatesCommand}"
                                ToolTip.Tip="报告当前版本与更新方式（不做静默自动升级）" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding IsReachable, Converter={StaticResource ReachableBrush}}" />
                        <TextBlock Text="{Binding Version, StringFormat='版本：{0}'}" FontSize="12"
                                   Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgPrimary}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}"
                               Text="本机无 NVIDIA GPU 时走 CPU 推理（GGUF）。CUDA/FlashAttention/vLLM 等 GPU 加速需相应硬件，未检测到时不启用。在聊天页选择 Ollama provider 与对应模型即可使用本地模型。" />
                </StackPanel>
            </Border>

            <!-- 已安装模型列表 -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="已安装模型" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" />
                        <Button Grid.Column="1" Content="设为聊天默认" Command="{Binding SetAsDefaultModelCommand}"
                                Margin="0,0,8,0"
                                ToolTip.Tip="把选中的已装模型设为 ollama provider 默认模型（聊天实际使用），热重载免重启" />
                        <Button Grid.Column="2" Content="删除选中" Command="{Binding DeleteSelectedModelCommand}"
                                ToolTip.Tip="删除上方列表选中的本地模型" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                             MinHeight="80" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:LocalModelItemViewModel">
                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                           Foreground="{DynamicResource FgPrimary}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CurrentDefaultModel, StringFormat='当前聊天默认本地模型：{0}'}"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FgPrimary}" />
                </StackPanel>
            </Border>

            <!-- 拉取模型 -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="拉取新模型（网站 / Ollama 仓库 / HuggingFace）" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Watermark="模型名，如 qwen2.5:1.5b 或 hf.co/user/repo:Q4_K_M" FontSize="12"
                                 Text="{Binding PullModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="拉取" Margin="8,0,0,0"
                                Command="{Binding PullModelCommand}"
                                ToolTip.Tip="从 Ollama 仓库下载该模型（GGUF），进度见下；支持 hf.co/ HuggingFace 前缀（Ollama 0.34+）" />
                    </Grid>
                    <TextBlock Text="模型目录（选中后一键拉取）" FontSize="12" Foreground="{DynamicResource FgMuted}" />
                    <ListBox ItemsSource="{Binding Catalog}" SelectedItem="{Binding SelectedCatalogModel, Mode=TwoWay}"
                             MinHeight="60" MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:CatalogModelItem">
                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                           Foreground="{DynamicResource FgPrimary}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="拉取选中模型" Command="{Binding PullCatalogModelCommand}"
                            ToolTip.Tip="一键拉取上方目录选中的模型" />
                    <TextBlock Text="{Binding PullProgress}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgPrimary}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
                </StackPanel>
            </Border>

            <!-- 导入本地 GGUF（从网站如 HuggingFace 下载后载入） -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="导入本地 GGUF 文件" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBox Watermark="本地 .gguf 文件绝对路径，如 D:\models\qwen.gguf" FontSize="12"
                             Text="{Binding ImportGgufPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Watermark="导入后的模型名，如 my-model:latest" FontSize="12"
                                 Text="{Binding ImportGgufName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="导入" Margin="8,0,0,0"
                                Command="{Binding ImportGgufCommand}"
                                ToolTip.Tip="把本地 .gguf 文件导入 Ollama（ollama create），导入后即可在聊天中使用" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}"
                               Text="从 HuggingFace 等网站下载 .gguf 文件后，填入绝对路径并命名导入；导入成功后出现在已安装模型列表，可设为聊天默认。" />
                </StackPanel>
            </Border>

            <!-- 参数调节（Ollama options，应用到 ollama provider，保存后热重载免重启） -->
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="参数调节（GGUF / Ollama options）" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        <Button Grid.Column="1" Content="应用参数" Command="{Binding ApplyOptionsCommand}"
                                ToolTip.Tip="把调参写入 ollama provider 并热重载，无需重启即生效" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,160,*">
                        <TextBlock Grid.Column="0" Text="上下文 num_ctx" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" />
                        <NumericUpDown Grid.Column="1" Value="{Binding NumCtx, Mode=TwoWay}" Minimum="0" Maximum="131072" Increment="512" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="GPU 层 num_gpu" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="3" Value="{Binding NumGpu, Mode=TwoWay}" Minimum="0" Maximum="999" Increment="1" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,160,*">
                        <TextBlock Grid.Column="0" Text="线程 num_thread" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" />
                        <NumericUpDown Grid.Column="1" Value="{Binding NumThread, Mode=TwoWay}" Minimum="0" Maximum="128" Increment="1" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="温度 temperature" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="3" Value="{Binding Temperature, Mode=TwoWay}" Minimum="0" Maximum="2" Increment="0.1" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,160,*">
                        <TextBlock Grid.Column="0" Text="top_p" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" />
                        <NumericUpDown Grid.Column="1" Value="{Binding TopP, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.05" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="top_k" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="3" Value="{Binding TopK, Mode=TwoWay}" Minimum="0" Maximum="500" Increment="5" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*,160,*">
                        <TextBlock Grid.Column="0" Text="重复惩罚 repeat_penalty" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" />
                        <NumericUpDown Grid.Column="1" Value="{Binding RepeatPenalty, Mode=TwoWay}" Minimum="0" Maximum="3" Increment="0.05" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="最大输出 num_predict" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="12,0,0,0" />
                        <NumericUpDown Grid.Column="3" Value="{Binding NumPredict, Mode=TwoWay}" Minimum="-1" Maximum="32768" Increment="128" FontSize="12" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgMuted}"
                               Text="调参写入 ollama provider 的请求体（ExtraBody），点「应用参数」保存并热重载，无需重启。num_gpu=0 为纯 CPU（本机无 NVIDIA GPU，集显卸载收益有限）；num_thread=0 / num_ctx=0 表示用 Ollama 默认。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
