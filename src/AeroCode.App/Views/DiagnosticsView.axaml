<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AeroCode.App.ViewModels"
             x:Class="AeroCode.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource BgDeep}">
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="V3 Diagnostics" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           Foreground="{DynamicResource FgMuted}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
                <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshAsyncCommand}" />
                <Button Grid.Column="3" Margin="6,0,0,0" Content="切换 Plan Mode"
                        Command="{Binding TogglePlanModeCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="14">
            <StackPanel Spacing="14">
                <!-- Stats grid -->
                <UniformGrid Columns="4" Rows="1">
                    <Border Padding="14" Margin="0,0,6,0" CornerRadius="8"
                            Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="工具调用" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                            <TextBlock Text="{Binding TotalToolCalls}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="3,0,3,0" CornerRadius="8"
                            Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Skill 调用" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                            <TextBlock Text="{Binding TotalInvocations}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="3,0,3,0" CornerRadius="8"
                            Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="待审批" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                            <TextBlock Text="{Binding TotalPendingEdits}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="6,0,0,0" CornerRadius="8"
                            Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Plan Mode" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                            <TextBlock Text="{Binding PlanModeEnabled}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Danger}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Provider health -->
                <Border Padding="14" CornerRadius="8" Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Provider 健康状态" Foreground="{DynamicResource Accent}"
                                   FontWeight="SemiBold" FontSize="14" />
                        <ItemsControl ItemsSource="{Binding ProviderHealths}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProviderHealth">
                                    <Border Padding="10,6" Margin="0,2" CornerRadius="4"
                                            Background="{DynamicResource BgElevated}">
                                        <Grid ColumnDefinitions="2*,1*,3*">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Foreground="{DynamicResource FgPrimary}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                       Foreground="{DynamicResource Accent}" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Capabilities}"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent events -->
                <Border Padding="14" CornerRadius="8" Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="最近事件流" Foreground="{DynamicResource Accent}"
                                   FontWeight="SemiBold" FontSize="14" />
                        <ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,10,0,0" MaxHeight="280">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EventLog">
                                    <Grid ColumnDefinitions="Auto,120,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding At, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11" FontFamily="Consolas,monospace" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="8,0"
                                                   Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   Foreground="{DynamicResource FgPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="Active Preset: " Foreground="{DynamicResource FgMuted}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding ActivePresetId}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="| Compaction: " Foreground="{DynamicResource FgMuted}" FontSize="11" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding CompactionStrategy}" Foreground="{DynamicResource Accent}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
